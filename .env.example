# Copy to .env.local and fill in. None of these are committed.

# Contact form. Required for /api/contact to send anything.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# GitHub section on the home page. Optional but recommended.
# Without it the API is unauthenticated (60 req/hour) and the contribution
# calendar is unavailable, since that comes from the GraphQL API which
# requires auth. Classic PAT with the read:user scope.
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Absolute base URL used to build blog share links.
# Falls back to https://aidenkopec.com when unset, so it is only needed if
# you are running under a different origin.
NEXT_PUBLIC_URL=
